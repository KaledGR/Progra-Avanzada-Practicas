@model RoleViewModel

<table class="table table-striped table-hover table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th scope="col">RoleID</th>
            <th scope="col">RoleName</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Role)
        {
            <tr>
                <td>@item.RoleId</td>
                <td>@item.RoleName</td>
            </tr>
        }
    </tbody>
</table>