@model ComponentViewModel

<table class="table table-striped table-hover table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th scope="col">ID</th>
            <th scope="col">name</th>
            <th scope="col">content</th>
            
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Component)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Content</td>               
            </tr>
        }
    </tbody>
</table>